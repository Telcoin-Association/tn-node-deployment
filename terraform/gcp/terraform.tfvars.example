# Copy to terraform.tfvars and edit. Every value here is public: nothing in
# this deployment is secret, and the BLS passphrase never passes through it.
# Addresses below are documentation examples, not real hosts.

# Where both hosts run. The project is required. The zone must offer the
# validator's machine type and Hyperdisk Balanced; null means <region>-a.
project = "my-validator-project"
region  = "us-central1"
# zone = "us-central1-b"

# testnet or mainnet.
network = "testnet"

# Starts every resource name, and labels them all as deployment.
name_prefix = "telcoin"

# The validator's execution address (on mainnet its Safe), printed into the
# key generation command.
# validator_address = "0x0000000000000000000000000000000000000001"

# Testnet only: the node release key generation installs.
# node_release_tag = "v0.18.0-adiri"

# First apply: leave rpc_domain empty. Point an A record for your RPC name at
# the gateway_public_ip output (or send tao_handoff to the Telcoin
# Association), wait until it resolves, then set it and apply again: that
# apply creates the worker gateway host.
rpc_domain = ""

# false builds a single node (an observer or an RPC node) with no gateway.
# gateway_enabled = true

# Shells go through IAP with OS Login by default, with no public SSH port.
# Members listed here get OS Login with sudo and the IAP tunnel on both
# instances; they also need roles/compute.viewer (or compute.instances.get and
# compute.projects.get) on the project. List IPv4 networks to open TCP 22 of
# both hosts to them as well.
# enable_iap    = true
# admin_members = ["user:ops@example.org"]
admin_ssh_cidrs = []
# admin_ssh_cidrs = ["198.51.100.7/32"]

# The trusted hubs map, written to the validator at first boot. Leave empty to
# copy it to the host yourself; next_steps names the path. It travels in the
# instance metadata.
# trusted_nodes_file = "trusted-nodes.yaml"

# Null takes the per-network defaults: c3-standard-8 on testnet,
# c3d-standard-16 on mainnet (8 cores, 64 GiB: twice the 32 GiB floor),
# e2-standard-2 for the worker gateway.
# validator_instance_type = "c3d-standard-16"
# gateway_instance_type   = "e2-standard-2"

# Null takes the per-network defaults, 500 GiB / 15000 IOPS / 300 MiB/s on
# testnet and 2000 GiB / 20000 IOPS / 300 MiB/s on mainnet. The floors are
# 350 GiB / 15000 IOPS / 240 MiB/s and 2000 GiB / 20000 IOPS / 300 MiB/s.
# data_disk_size_gb    = 2000
# data_disk_iops       = 20000
# data_disk_throughput = 300

# A Cloud KMS key of your own for every disk, instead of Google's key.
# disk_kms_key = "projects/my-validator-project/locations/us-central1/keyRings/tn/cryptoKeys/data"

# Ubuntu Server LTS: 26.04 (default) or 24.04.
# ubuntu_version = "26.04"

# The private network. The validator takes the subnet's 10th address and the
# worker gateway its 20th.
# vpc_cidr    = "10.42.0.0/16"
# subnet_cidr = "10.42.1.0/24"

# The worker gateway sends queries to the network's public RPC unless this
# names another, and keeps this many submissions a second for
# eth_sendRawTransaction (0 turns the reservation off).
# redirect_queries_url           = ""
# gateway_rate_limit_submissions = 300
