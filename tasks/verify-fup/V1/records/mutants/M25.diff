<     fi
<     # --host-baseline over an installed node: the baseline alone, nothing else.
<     if [[ "$HOST_BASELINE" == "true" ]] && ! json_mode && tn_resolve_service >/dev/null 2>&1; then
<         TN_SETUP_PASS=""
