[Unit]
Description=Telcoin Network Node Manager UI
After=network.target

[Service]
Type=simple
User=telcoin-ui
Group=telcoin-ui
# Code and interpreter are root-owned (install-ui.sh): the app in /opt/telcoin-ui,
# Flask and its dependencies in the venv /opt/telcoin-ui-venv, installed from the
# hashed ui/requirements.txt. The service account cannot change either.
WorkingDirectory=/opt/telcoin-ui
ExecStart=/opt/telcoin-ui-venv/bin/python /opt/telcoin-ui/server.py
# The only place the service writes: /var/lib/telcoin-ui (node-role.json).
StateDirectory=telcoin-ui
StateDirectoryMode=0750
UMask=0027
Restart=on-failure
RestartSec=5

# Resource caps. They bound the UI process and the light helper calls it makes.
# Updates and setup run in their own transient scope (the helper starts them with
# systemd-run --scope), so a source build is not held to these limits.
TasksMax=256
MemoryMax=512M
CPUQuota=50%
OOMScoreAdjust=500

# Hardening. NoNewPrivileges is intentionally NOT set: the service shells out
# to `sudo ...` via the narrow /etc/sudoers.d/telcoin-ui whitelist, and
# NoNewPrivileges would block sudo's setuid transition. The attack surface is
# bounded instead by the localhost-only bind (server.py listens on 127.0.0.1),
# the per-install token every API call carries, and the whitelisted helper
# commands.
#
# ProtectSystem and ProtectHome apply to the WHOLE service mount namespace --
# including the root helpers we sudo to. Those helpers legitimately write /etc
# (groupadd/useradd during setup, the systemd unit, /etc/telcoin, ufw rules) and
# /home (the service user's reth cache).
#
# ProtectSystem=full was tried with ReadWritePaths=/etc /home to carve those trees
# back, but on this kernel/systemd version ProtectSystem=full still bind-mounts
# /etc read-only (ro,relatime) regardless of ReadWritePaths -- so groupadd failed
# with "cannot lock /etc/group" and node removal could not delete the unit. Set
# ProtectSystem=false so /etc is writable in the namespace. Likewise
# ProtectHome=read-only made /home read-only in the namespace, so the root helper
# could not create /home/telcoin for the service user during setup -- set
# ProtectHome=false too. Neither reduces security in practice: the unprivileged
# Flask process (User=telcoin-ui) still cannot write /etc or /home by ordinary
# Unix permissions; only the root helper invoked via sudo can, which is the intent.
ProtectHome=false
ProtectSystem=false
PrivateTmp=yes

[Install]
WantedBy=multi-user.target
